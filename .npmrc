# @vitejs/plugin-react (через опциональный peer @rolldown/plugin-babel) требует
# @babel/plugin-transform-runtime ^7.29||^8.0.0-rc, а установленный shadcn тянет
# @babel/core@8.0.1 транзитивно другим путём — npm's strict peer resolution падает
# на этом конфликте одних dev-инструментов между собой, хотя рантайм-код они не делят.
legacy-peer-deps=true

# npm ci по умолчанию сам гоняет npm audit при каждой установке - в этом проекте это
# дублирует выделенный job `audit` (npm audit --audit-level=high) в ci.yml, который
# запускает его осознанно и с порогом. Без этой строки implicit-аудит молча выполнялся бы
# ещё и в lint/typecheck/test/build/e2e/openapi-types - без порога и без всякого эффекта.
audit=false
