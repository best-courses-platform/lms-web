# @vitejs/plugin-react (через опциональный peer @rolldown/plugin-babel) требует
# @babel/plugin-transform-runtime ^7.29||^8.0.0-rc, а установленный shadcn тянет
# @babel/core@8.0.1 транзитивно другим путём — npm's strict peer resolution падает
# на этом конфликте одних dev-инструментов между собой, хотя рантайм-код они не делят.
legacy-peer-deps=true
